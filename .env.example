# Runtime mode
DJANGO_SETTINGS_MODULE=connectnepal.settings.prod
# Dev: docker compose -f infra/docker-compose.yml -f infra/docker-compose.dev.yml up --build
# Prod: docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml up -d

# PostgreSQL container settings
POSTGRES_DB=connectnepal
POSTGRES_USER=connectnepal
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Django database settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=connectnepal
DB_USER=connectnepal
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# Django security
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
TRUST_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
ENABLE_HSTS=False

# URLs
FRONTEND_URL=http://localhost
BACKEND_BASE_URL=http://localhost
NGINX_PORT=80
VITE_API_URL=http://localhost/api
ENABLE_CHATBOT=true
ENABLE_RECOMMENDATIONS=true
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_RECOMMENDATIONS=true

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=noreply@example.test
EMAIL_HOST_PASSWORD=not-used
EMAIL_USE_TLS=False

# Celery / Redis
REDIS_PORT=6379
REDIS_HOST=redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_RECOMMENDATIONS_URL=redis://redis:6379/1
REDIS_DASHBOARDS_URL=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# eSewa
ESEWA_SECRET_KEY=replace-me
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Gunicorn / Celery process tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=2
WAIT_FOR_DB_TIMEOUT=60
WAIT_FOR_DB_INTERVAL=2
AUTO_APPLY_MIGRATIONS=true
AUTO_COLLECTSTATIC=true

# Production overlay resource tuning
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=256m
REDIS_CPUS=0.50
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
API_MEM_LIMIT=768m
API_CPUS=1.0
CELERY_WORKER_MEM_LIMIT=768m
CELERY_WORKER_CPUS=1.0
CELERY_BEAT_MEM_LIMIT=256m
CELERY_BEAT_CPUS=0.50
NGINX_MEM_LIMIT=128m
NGINX_CPUS=0.50
